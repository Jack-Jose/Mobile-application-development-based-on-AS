<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/slate_50">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="我的预约" android:textSize="20sp" android:textStyle="bold"
        android:gravity="center" android:padding="14dp" android:background="@color/white"
        android:textColor="@color/slate_800" android:elevation="2dp"/>

    <!-- 状态筛选Tab -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="10dp" android:background="@color/white"
        android:elevation="1dp">
        <TextView android:id="@+id/tv_filter_all" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="32dp"
            android:text="全部" android:gravity="center" android:textSize="12sp"
            android:background="@drawable/pill_tab" android:textColor="@color/white"
            android:layout_marginEnd="6dp"/>
        <TextView android:id="@+id/tv_filter_pending" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="32dp"
            android:text="待审批" android:gravity="center" android:textSize="12sp"
            android:background="@drawable/pill_tab" android:textColor="@color/slate_500"
            android:layout_marginEnd="4dp" android:layout_marginStart="2dp"/>
        <TextView android:id="@+id/tv_filter_approved" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="32dp"
            android:text="已通过" android:gravity="center" android:textSize="12sp"
            android:background="@drawable/pill_tab" android:textColor="@color/slate_500"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp"/>
        <TextView android:id="@+id/tv_filter_cancelled" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="32dp"
            android:text="已取消" android:gravity="center" android:textSize="12sp"
            android:background="@drawable/pill_tab" android:textColor="@color/slate_500"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_reservations"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"/>
</LinearLayout>