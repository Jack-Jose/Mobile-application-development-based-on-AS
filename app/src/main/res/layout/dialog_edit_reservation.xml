<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText android:id="@+id/et_edit_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="会议主题" android:padding="12dp"
        android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/et_duration" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="时长（分钟）" android:inputType="number"
        android:padding="12dp" android:layout_marginBottom="10dp"/>

    <EditText android:id="@+id/et_edit_note" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="备注" android:padding="12dp"/>
</LinearLayout>
