<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="14dp"
    android:layout_margin="4dp"
    android:elevation="1dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tv_approval_title" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/slate_800"/>
        <TextView android:id="@+id/tv_approval_room" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/blue_500" android:textStyle="bold"/>
    </LinearLayout>

    <TextView android:id="@+id/tv_approval_user" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textColor="@color/slate_500" android:layout_marginTop="4dp"/>

    <TextView android:id="@+id/tv_approval_time" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp"
        android:textColor="@color/slate_700" android:layout_marginTop="2dp"/>

    <TextView android:id="@+id/tv_approval_detail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="11sp"
        android:textColor="@color/slate_500" android:layout_marginTop="2dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <Button android:id="@+id/btn_approve" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="36dp" android:text="通过"
            android:backgroundTint="@color/emerald_500" android:textColor="@color/white"
            android:textSize="13sp" android:layout_marginEnd="6dp"/>
        <Button android:id="@+id/btn_reject" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="36dp" android:text="拒绝"
            android:backgroundTint="@color/red_500" android:textColor="@color/white"
            android:textSize="13sp" android:layout_marginEnd="6dp"/>
        <Button android:id="@+id/btn_paid" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="36dp" android:text="代付"
            android:backgroundTint="@color/amber_500" android:textColor="@color/white"
            android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>