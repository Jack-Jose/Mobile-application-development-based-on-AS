<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="注册新用户" android:textSize="22sp" android:textStyle="bold"
        android:gravity="center" android:layout_marginBottom="24dp" android:layout_gravity="center"/>

    <EditText android:id="@+id/et_reg_username" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="用户名" android:padding="12dp"
        android:background="@drawable/edit_bg" android:layout_marginBottom="12dp"/>

    <EditText android:id="@+id/et_reg_password" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="密码" android:inputType="textPassword"
        android:padding="12dp" android:background="@drawable/edit_bg" android:layout_marginBottom="12dp"/>

    <EditText android:id="@+id/et_reg_confirm" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="确认密码" android:inputType="textPassword"
        android:padding="12dp" android:background="@drawable/edit_bg" android:layout_marginBottom="12dp"/>

    <EditText android:id="@+id/et_reg_phone" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="手机号" android:inputType="phone"
        android:padding="12dp" android:background="@drawable/edit_bg" android:layout_marginBottom="12dp"/>

    <EditText android:id="@+id/et_reg_dept" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="部门" android:padding="12dp"
        android:background="@drawable/edit_bg" android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/btn_register" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="注 册"
        android:backgroundTint="#2563EB" android:textColor="#FFFFFF"
        android:padding="14dp" android:textSize="16sp"/>
</LinearLayout>
